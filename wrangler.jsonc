{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketpull-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-16",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  }
  // Secrets are managed via `wrangler secret put` and .dev.vars (local).
  // The Pokémon TCG API key is accessed as env.POKEMON_TCG_API_KEY.
}
